## 目录显示颜色
alias ls='ls -G'
alias grep='grep --color'
alias tailf='tail -f'

alias znote='cd ~/Desktop/dd/note/'

#其他应用
alias composer="~/mscript/composer"
alias phpctags="~/mscript/phpctags"
alias phpstan="~/.composer/vendor/bin/phpstan"
alias vim="~/.local/bin/vim"
alias vimdiff="~/.local/bin/vimdiff"
alias nvim="~/build-ext/nvim-macos/bin/nvim"

alias jf="pbpaste | jq ."
alias jformat="pbpaste | jq ."

# grpc
alias gu="grpcui -plaintext"
