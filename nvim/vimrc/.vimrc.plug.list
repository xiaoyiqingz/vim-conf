" Plugin list{
    " 临时禁用某个插件直接将Plugin注释掉即可

    call plug#begin()

    " Color & Theme {
        Plug 'flazz/vim-colorschemes'
        Plug 'vim-airline/vim-airline'
        Plug 'vim-airline/vim-airline-themes'
    " }

    " Utils {
        Plug 'voldikss/vim-floaterm'
        Plug 'ntpeters/vim-better-whitespace' " 显示行尾空格
        Plug 'Raimondi/delimitMate'            " [ ' 的匹配
        Plug 'godlygeek/tabular'               " 文本对齐
        Plug 'tpope/vim-surround'
        Plug 'gcmt/wildfire.vim'
        Plug 'majutsushi/tagbar'
        Plug 'vim-php/phpctags', {'do': 'composer install',  'for': 'php' }
        Plug 'Shougo/unite.vim'
        Plug 'yggdroot/leaderf'
        Plug 'skywind3000/Leaderf-snippet'
        Plug 'Yggdroot/LeaderF-changes'
        Plug 'Yggdroot/LeaderF-marks'
        Plug 'tpope/vim-fugitive'
        Plug 'alvan/vim-php-manual'
        Plug 'andrewstuart/vim-kubernetes', { 'for': 'yaml' }
    " }

    " markdown {
        Plug 'plasticboy/vim-markdown', {'for': 'markdown'} "table format or other
        Plug 'dhruvasagar/vim-table-mode', {'for': 'markdown'} " easy write table
        Plug 'iamcco/markdown-preview.nvim', { 'do': { -> mkdp#util#install() }, 'for': ['markdown', 'vim-plug']}
    " }

    " yaml {
        Plug 'yggdroot/indentline', {'for': 'yaml'}
        Plug 'pedrohdz/vim-yaml-folds', {'for': 'yaml'}
    " }

    " checker {
        Plug 'dense-analysis/ale'
    " }

    " Auto Complete {
        if has('nvim')
            Plug 'Shougo/deoplete.nvim', { 'do': ':UpdateRemotePlugins' }
         else
            Plug 'Shougo/deoplete.nvim'
            Plug 'roxma/vim-hug-neovim-rpc'
            Plug 'roxma/nvim-yarp'
        endif

        " code snippets {
            Plug 'SirVer/ultisnips'
            Plug 'honza/vim-snippets'

            Plug 'mattn/emmet-vim'       " for html complete
        " }

        " for php {
            let s:php_version = GetPHPVersion()
            if s:php_version == '8'
                Plug 'xiaoyiqingz/phpcd.vim', {'dir': '~/.vim/plugged/phpcd8.vim' , 'tag': 'v2.0.1' , 'for': 'php', 'do': 'composer install', 'frozen' : 1 }
            else
                Plug 'xiaoyiqingz/phpcd.vim', {'tag': 'v1.0.1' , 'for': 'php', 'do': 'composer install', 'frozen' : 1 }
            endif

            Plug 'arnaud-lb/vim-php-namespace', { 'for': 'php' }
            "Plug 'phpactor/phpactor', {'for': 'php', 'tag': '*', 'do': 'composer install --no-dev -o'}
            "Plug 'lvht/phpcd.vim', { 'for': 'php', 'do': 'composer install', 'frozen' : 1 }
       "}

        " for go {
            Plug 'fatih/vim-go', { 'do': ':GoUpdateBinaries', 'for': 'go' }
        " }

        " for c {
            Plug 'rip-rip/clang_complete', { 'for': 'c' }
        " }

        " for js
            Plug 'wokalski/autocomplete-flow', { 'for': 'js' }
            " For func argument completion
            Plug 'Shougo/neosnippet'
            Plug 'Shougo/neosnippet-snippets'
            Plug 'carlitux/deoplete-ternjs', { 'for': 'js' , 'do': 'npm install -g tern' }
        " }

        " for vims {
            Plug 'shougo/neco-vim'
        " }

        " for protobuf {
            Plug 'bufbuild/vim-buf'
        " }

        " for sql {
            Plug 'vim-scripts/dbext.vim', { 'for': 'sql' }
        " }
    " }

    if has('nvim')
        " Plug 'ncm2/float-preview.nvim'
        " Plug 'neoclide/coc.nvim', {'branch': 'release'}
        Plug 'nvim-treesitter/nvim-treesitter', {'do': ':TSUpdate'}
    endif

    call plug#end()
" }
